{
  "name": "roles-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite --host 127.0.0.1 --port 5175",
    "dev:backend": "python backend/manage.py runserver 127.0.0.1:8000",
